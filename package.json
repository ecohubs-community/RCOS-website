{
	"name": "RCOS-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5175",
		"build:templates": "node scripts/build-templates.mjs",
		"build:core": "node scripts/build-core.mjs",
		"build:downloads": "pnpm run build:templates && pnpm run build:core",
		"check:i18n": "node scripts/check-i18n-keys.mjs",
		"check:translations": "node scripts/check-translations.mjs",
		"translate": "node scripts/translate.mjs",
		"normalize:rfc-keywords": "node scripts/normalize-rfc-keywords.mjs",
		"normalize:terms": "node scripts/normalize-terms.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.91.1",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@google/genai": "^1.50.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"mdsvex": "^0.12.6",
		"minisearch": "^7.2.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@iconify/svelte": "^5.1.0",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.1"
	}
}
