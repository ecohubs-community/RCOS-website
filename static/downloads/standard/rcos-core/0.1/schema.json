{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "RCOS standard data",
	"description": "Schemas for the files published under /downloads/standard/<standard>/<version>/. Licence of the data: CC BY 4.0.",
	"$defs": {
		"clauses": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"ref": {
						"type": "string",
						"pattern": "^\\d+\\.\\d+\\.\\d+$",
						"description": "Number as written in the standard, e.g. 2.1.1. Can change between versions."
					},
					"layer": {
						"type": "integer",
						"minimum": 0,
						"maximum": 6
					},
					"specSection": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"ref": {
										"type": "string"
									},
									"title": {
										"type": "string"
									}
								},
								"required": [
									"ref",
									"title"
								],
								"additionalProperties": false
							},
							{
								"type": "null"
							}
						]
					},
					"normativity": {
						"type": "string",
						"enum": [
							"MUST",
							"SHOULD",
							"MAY",
							"INFORMATIVE"
						]
					},
					"key": {
						"type": "string",
						"description": "Stable identifier, e.g. l0.purpose-definition.1. Use this to link to a clause."
					},
					"i18n": {
						"type": "object",
						"properties": {
							"en": {
								"type": "string"
							},
							"de": {
								"type": "string"
							},
							"es": {
								"type": "string"
							},
							"fr": {
								"type": "string"
							},
							"pt-br": {
								"type": "string"
							}
						},
						"required": [
							"en"
						],
						"additionalProperties": false
					},
					"disposition": {
						"type": "string",
						"enum": [
							"defined_by_section",
							"satisfied_by_platform",
							"not_a_definition"
						]
					},
					"dispositionNote": {
						"type": "string"
					},
					"referencedBy": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
						}
					},
					"owner": {
						"anyOf": [
							{
								"type": "string",
								"pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
							},
							{
								"type": "null"
							}
						],
						"description": "The one template section that answers this clause."
					}
				},
				"required": [
					"ref",
					"layer",
					"specSection",
					"normativity",
					"key",
					"i18n",
					"disposition",
					"referencedBy",
					"owner"
				],
				"additionalProperties": false,
				"description": "A numbered rule of the standard"
			}
		},
