					"dispositionNote": {
						"type": [
							"string",
							"null"
						]
					},
					"ownsClauses": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^\\d+\\.\\d+\\.\\d+$"
						}
					}
				},
				"required": [
					"key",
					"artifact",
					"order",
					"clauseRefs",
					"i18n",
					"disposition",
					"dispositionNote",
					"ownsClauses"
				],
				"additionalProperties": false,
				"description": "A section of a template (artifact): one thing a community writes down"
			}
		},
